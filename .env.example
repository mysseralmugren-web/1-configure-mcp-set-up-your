# ============================================================
# AlMuqrin Furniture & Decor Factory — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or real secrets to git.

# ─────────────────────────────────────────
# Public Site URL
# ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.almuqrinfurniturefactory.com

# ─────────────────────────────────────────
# Supabase (for Catalog, Projects, Media)
# ─────────────────────────────────────────
# Obtain from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-only key — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ─────────────────────────────────────────
# Storage Bucket (Supabase Storage)
# ─────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=almuqrin-media
NEXT_PUBLIC_MODELS_BUCKET=almuqrin-3d-models

# ─────────────────────────────────────────
# Admin Authentication (NextAuth / Supabase Auth)
# ─────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-secret
NEXTAUTH_URL=https://www.almuqrinfurniturefactory.com

# Admin portal credentials (used for simple HTTP-based auth if not using Supabase Auth)
ADMIN_EMAIL=admin@almuqrinfurniturefactory.com
ADMIN_PASSWORD_HASH=bcrypt-hashed-password-here

# ─────────────────────────────────────────
# Email Notifications (optional)
# ─────────────────────────────────────────
# Resend: https://resend.com
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL_TO=sales@almuqrinfurniturefactory.com
NOTIFICATION_EMAIL_FROM=noreply@almuqrinfurniturefactory.com

# ─────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_3D_VIEWER=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
