      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/request\\-quote(?:/)?$"
    },
    {
      "page": "/[locale]/services",
      "regex": "^/([^/]+?)/services(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/services(?:/)?$"
    },
    {
      "page": "/[locale]/services/[slug]",
